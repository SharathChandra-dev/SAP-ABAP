@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Flight',
  typeNamePlural: 'Flights',
  title: {
    type: #STANDARD,
    value: 'CarrierID'
  },
  description: {
    type: #STANDARD,
    value: 'ConnectionID'
  }
}
annotate view ZC_8892FLIGHT with
{
  @UI.facet: [
    {
      label: 'Flight Information',
      id: 'GeneralInfo',
      purpose: #STANDARD,
      position: 10,
      type: #IDENTIFICATION_REFERENCE
    }
  ]

  @EndUserText.label: 'Airline ID'
  @UI.identification: [ { position: 10 } ]
  @UI.lineItem: [ { position: 10 } ]
  @UI.selectionField: [ { position: 10 } ]
  CarrierID;

  @EndUserText.label: 'Connection ID'
  @UI.identification: [ { position: 20 } ]
  @UI.lineItem: [ { position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  ConnectionID;

  @EndUserText.label: 'Flight Date'
  @UI.identification: [ { position: 30 } ]
  @UI.lineItem: [ { position: 30 } ]
  FlightDate;

  @EndUserText.label: 'Plane Type'
  @UI.identification: [ { position: 35 } ]
  @UI.lineItem: [ { position: 50 } ]
  PlaneTypeID;

  @EndUserText.label: 'Flight Price'
  @UI.identification: [ { position: 40 } ]
  @UI.lineItem: [ { position: 40 } ]
  Price;

  @EndUserText.label: 'Currency'
  @UI.identification: [ { position: 45 } ]
  CurrencyCode;

  @UI.hidden: true
  LocalCreatedBy;

  @UI.hidden: true
  LocalCreatedAt;

  @UI.hidden: true
  LocalLastChangedBy;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}