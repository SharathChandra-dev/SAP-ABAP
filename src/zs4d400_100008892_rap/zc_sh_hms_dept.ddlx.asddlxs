  DepartmentName;

  @UI.lineItem: [ { position: 30, label: 'Floor' } ]
  @UI.identification: [ { position: 30, label: 'Floor' } ]
  FloorNo;

  @UI.lineItem: [ { position: 40, label: 'Active' } ]
