@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Doctor',
  typeNamePlural: 'Doctors',
  title: { type: #STANDARD, value: 'DoctorID' },
  description: { type: #STANDARD, value: 'DoctorName' }
}
annotate view ZC_SH_HMS_DOCTOR with
{
